# Curieux orchestre — variables Supabase
#
# Cette app est du HTML/JS statique sans étape de build : il n'y a pas de
# lecture de .env au runtime, les valeurs sont écrites en dur dans
# assets/db.js. Ce fichier sert de référence/documentation (et pour un futur
# passage à un bundler ou des env vars Vercel si besoin).
#
# La clé "anon/publishable" Supabase n'est PAS un secret à cacher : elle est
# faite pour être exposée côté client. La sécurité vient des policies RLS
# définies dans migrations.sql (accès public volontaire, pas de compte), pas
# de la confidentialité de cette clé.

SUPABASE_URL=https://nffqcvysweidquouulzs.supabase.co
SUPABASE_ANON_KEY=sb_publishable_-QZnJEZi01-5fjkjv_2SPw_wODqHcJQ
