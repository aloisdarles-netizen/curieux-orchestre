# ============================================================================
# Ce qui ne part PAS sur le site
# ============================================================================
# Tout ce que le dépôt contient était jusqu'ici servi tel quel sous
# prod.lessoudaines.fr : le schéma de la base et ses politiques RLS
# (migrations.sql, 200), les maquettes, les notes de déploiement. Rien de
# secret n'y traîne — c'est vérifié — mais donner à lire la carte complète des
# règles d'accès depuis le domaine de l'application n'apporte rien à personne,
# sinon à qui cherche une faille.
#
# La règle : ne déployer que ce que le navigateur demande vraiment.
#
# ATTENTION à ce qu'on ajoute ici. modeles/ reste déployé : devis.html va y
# chercher devis-exemples.json à l'exécution (fetch). Avant d'exclure un
# dossier, vérifier qu'aucune page ne le charge.
# ============================================================================

# La base : son schéma et son jeu d'essai n'ont rien à faire sur le web.
migrations.sql
jeu-de-demo.sql

# La documentation du dépôt — elle s'adresse à qui développe, pas à qui visite.
*.md

# Les maquettes : des pages figées, doublons trompeurs des vraies.
maquette/

# L'outillage de développement (captures, vérification de QR, extraction de
# schéma) — dont un __pycache__ qui n'aurait jamais dû être versionné.
outils/

# Dossier créé par erreur par un script (un chemin non défini), qui ne contient
# que deux captures d'écran. À supprimer du dépôt à l'occasion.
undefined/

# Les réglages de l'agent et l'exemple d'environnement.
.claude/
.env.example
